generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GUEST
  STUDENT
  PARENT
  TEACHER
  DIRECTOR
  TELECALLER
  MARKETING_COORDINATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELLING
  ENROLLED
  LOST
}

enum CounsellingMode {
  ONLINE
  OFFLINE
}

enum HostelType {
  BOYS
  GIRLS
}

enum InOutType {
  IN
  OUT
}

enum OtpType {
  LOGIN
  FORGOT_PASSWORD
  SIGNUP
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  mobile         String   @unique
  password       String
  role           Role     @default(STUDENT)
  instituteId    String?
  branchId       String?
  roleMetadata   Json?
  roleOnboardingStatus String @default("PENDING")
  roleActivatedAt DateTime?
  lastRoleActivityAt DateTime?
  emailVerified  Boolean  @default(false)
  mobileVerified Boolean  @default(false)
  isDisabled      Boolean  @default(false)
  disabledAt      DateTime?
  loginFailureCount Int    @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  enrollments    Enrollment[]
  testAttempts   TestAttempt[]
  psychometricAttempts PsychometricAttempt[]
  olqScore       OLQScore?
  studyPlans     StudyPlan[]
  performanceAnalytics PerformanceAnalytics?
  revisionSchedules RevisionSchedule[]
  lectureProgress LectureProgress[]
  attendanceRecords Attendance[] @relation("AttendanceUser")
  markedAttendance Attendance[] @relation("AttendanceMarker")
  facultyProfile Faculty?
  hostelAllocations HostelAllocation[] @relation("HostelAllocationStudent")
  inOutEntries InOutEntry[] @relation("InOutEntryStudent")
  hostelLeaves HostelLeave[] @relation("HostelLeaveStudent")
  approvedHostelLeaves HostelLeave[] @relation("HostelLeaveApprover")
  disciplineRecords DisciplineRecord[] @relation("DisciplineRecordStudent")
  recordedDiscipline DisciplineRecord[] @relation("DisciplineRecordRecorder")
  paradePerformances ParadePerformance[] @relation("ParadePerformanceStudent")
  assignedLeads Lead[] @relation("LeadAssignee")
  followUpsCreated FollowUp[] @relation("FollowUpCreator")
  admissions Admission[] @relation("AdmissionStudent")
  referralsMade Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferred")
  payments Payment[] @relation("PaymentUser")
  collectedPayments Payment[] @relation("PaymentCollector")
  verifiedPayments Payment[] @relation("PaymentVerifier")
  subscriptions Subscription[] @relation("SubscriptionUser")
  feeInstallments FeeInstallment[] @relation("FeeInstallmentStudent")
  invoices Invoice[] @relation("InvoiceStudent")
  approvalRequestsCreated ApprovalRequest[] @relation("ApprovalRequester")
  approvalRequestsReviewed ApprovalRequest[] @relation("ApprovalReviewer")
  scholarships ScholarshipDiscount[] @relation("ScholarshipStudent")
  scholarshipReviewActions ScholarshipDiscount[] @relation("ScholarshipApprover")
  notifications Notification[] @relation("NotificationUser")
  messageThreads MessageThread[] @relation("MessageThreadCreator")
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  communicationAnnouncements Announcement[] @relation("AnnouncementCreator")
  aiInterviewSessions AIInterviewSession[]
  doubtQueries DoubtQuery[]
  aiRecommendations AIRecommendation[]
  officerPotential OfficerPotential?
  fitnessProfile FitnessProfile?
  ptAttendances PTAttendance[] @relation("PTAttendanceStudent")
  physicalEligibilities PhysicalEligibility[]
  dailyFitnessLogs DailyFitnessLog[]
  quizBattleParticipants QuizBattleParticipant[]
  leaderboard Leaderboard?
  mediaFolders MediaFolder[] @relation("MediaFolderCreator")
  mediaFiles MediaFile[] @relation("MediaFileUploader")
  documents Document[] @relation("DocumentUploader")
  adminRoles UserRole[]
  roleActivities RoleActivity[]
  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]
  salesBoosterCampaignsCreated SalesBoosterCampaign[] @relation("SalesBoosterCampaignCreator")
  salesBoosterCampaignsApproved SalesBoosterCampaign[] @relation("SalesBoosterCampaignApprover")
  sessionTokens SessionToken[]
  passwordResets PasswordReset[]
  parentInvitationsSent ParentStudentInvitation[] @relation("ParentInvitationParent")
  parentInvitationsReceived ParentStudentInvitation[] @relation("ParentInvitationStudent")
  parentLinks ParentStudentLink[] @relation("ParentLinkParent")
  studentLinks ParentStudentLink[] @relation("ParentLinkStudent")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([role])
  @@index([instituteId])
  @@index([branchId])
  @@index([roleOnboardingStatus])
}

model SessionToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model ParentStudentInvitation {
  id          String   @id @default(cuid())
  parentId    String
  studentId   String
  tokenHash   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  parent      User     @relation("ParentInvitationParent", fields: [parentId], references: [id], onDelete: Cascade)
  student     User     @relation("ParentInvitationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId, studentId])
  @@index([expiresAt])
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  status    String   @default("ACTIVE")
  monitoringPermissions Json?
  lastViewedAt DateTime?
  linkedAt  DateTime @default(now())
  parent    User     @relation("ParentLinkParent", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("ParentLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([status])
}

model Otp {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  type       OtpType
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  thumbnail   String
  category    String
  examType    String
  duration    String
  price       Float
  isPremium   Boolean      @default(false)
  modules     Module[]
  enrollments Enrollment[]
  recordedLectures RecordedLecture[]
  admissions  Admission[]
  payments    Payment[]
  feePlans    FeePlan[]
  createdAt   DateTime     @default(now())
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  description String
  videoUrl    String
  pdfUrl      String
  duration    String
  isPreview   Boolean @default(false)
  order       Int
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  progress   Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Test {
  id          String        @id @default(cuid())
  title       String
  description String
  examType    String
  category    String
  duration    Int
  totalMarks  Float
  isMockTest  Boolean       @default(true)
  isLive      Boolean       @default(false)
  questions   Question[]
  attempts    TestAttempt[]
  createdAt   DateTime      @default(now())
}

model Question {
  id              String   @id @default(cuid())
  testId          String
  questionText    String
  questionImage   String?
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  explanation     String
  marks           Float
  negativeMarks   Float
  difficultyLevel String
  topic           String
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers         Answer[]
  answerStates    CBTAnswerState[]

  @@index([testId])
}

model TestAttempt {
  id           String    @id @default(cuid())
  userId       String
  testId       String
  score        Float     @default(0)
  totalCorrect Int       @default(0)
  totalWrong   Int       @default(0)
  timeTaken    Int       @default(0)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  lastSavedAt   DateTime?
  status        String    @default("IN_PROGRESS")
  currentQuestionId String?
  sectionState  Json?
  integrityScore Int      @default(100)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      Answer[]
  answerStates CBTAnswerState[]
  integrityEvents CBTIntegrityEvent[]

  @@index([userId])
  @@index([testId])
}

model CBTAnswerState {
  id              String   @id @default(cuid())
  attemptId       String
  questionId      String
  selectedAnswer  String?
  status          String   @default("UNANSWERED")
  confidence      String?
  timeSpent       Int      @default(0)
  visitCount      Int      @default(0)
  markedForReview Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  attempt         TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, status])
  @@index([questionId])
}

model CBTIntegrityEvent {
  id         String   @id @default(cuid())
  attemptId  String
  eventType  String
  severity   String   @default("LOW")
  metadata   Json?
  createdAt  DateTime @default(now())
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([eventType])
  @@index([createdAt])
}

model Answer {
  id             String      @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model PsychometricTest {
  id           String                 @id @default(cuid())
  title        String
  type         String
  description  String
  duration     Int
  instructions String
  access       String                 @default("CORE")
  category     String                 @default("GENERAL")
  isActive     Boolean                @default(true)
  questions    PsychometricQuestion[]
  attempts     PsychometricAttempt[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model PsychometricQuestion {
  id           String            @id @default(cuid())
  testId       String
  questionText String
  imageUrl     String?
  questionType String
  options      Json?
  order        Int
  test         PsychometricTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      PsychometricAnswer[]

  @@index([testId])
}

model PsychometricAttempt {
  id            String                @id @default(cuid())
  userId        String
  testId        String
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  score         Float                 @default(0)
  aiAnalysis    String?
  overallRemark String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  test          PsychometricTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       PsychometricAnswer[]
  reportSnapshot PsychometricReport?

  @@index([userId])
  @@index([testId])
}

model PsychometricReport {
  id               String             @id @default(cuid())
  attemptId        String             @unique
  userId           String
  testId           String
  score            Float
  readinessBand    String
  report           Json
  scoring          Json
  recommendations  Json
  integritySignals Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  attempt          PsychometricAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
  @@index([createdAt])
}

model PsychometricAnswer {
  id             String               @id @default(cuid())
  attemptId      String
  questionId     String
  answerText     String?
  selectedOption String?
  score          Float                @default(0)
  attempt        PsychometricAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       PsychometricQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model OLQScore {
  id                   String   @id @default(cuid())
  userId               String   @unique
  effectiveIntelligence Int     @default(0)
  reasoningAbility      Int     @default(0)
  organizingAbility     Int     @default(0)
  socialAdaptability    Int     @default(0)
  cooperation           Int     @default(0)
  senseOfResponsibility Int     @default(0)
  initiative            Int     @default(0)
  selfConfidence        Int     @default(0)
  speedOfDecision       Int     @default(0)
  abilityToInfluence    Int     @default(0)
  liveliness            Int     @default(0)
  determination         Int     @default(0)
  courage               Int     @default(0)
  stamina               Int     @default(0)
  emotionalStability    Int     @default(0)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id               String   @id @default(cuid())
  userId           String
  targetExam       String
  studyHoursPerDay Int
  targetDate       DateTime
  strengths        Json
  weaknesses       Json
  generatedPlan    Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PerformanceAnalytics {
  id               String   @id @default(cuid())
  userId           String   @unique
  testAccuracy     Float    @default(0)
  weakTopics       Json
  strongTopics     Json
  averageScore     Float    @default(0)
  studyConsistency Int      @default(0)
  revisionRate     Int      @default(0)
  aiSuggestions    Json
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevisionSchedule {
  id           String   @id @default(cuid())
  userId       String
  topic        String
  revisionDate DateTime
  status       String   @default("PENDING")
  priority     String   @default("MEDIUM")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LiveClass {
  id             String   @id @default(cuid())
  title          String
  description    String
  examType       String
  instructorName String
  scheduledAt    DateTime
  duration       Int
  meetingLink    String
  thumbnail      String
  isLive         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model RecordedLecture {
  id             String   @id @default(cuid())
  title          String
  description    String
  courseId       String?
  moduleId       String?
  videoUrl       String
  thumbnail      String
  duration       Int
  instructorName String
  createdAt      DateTime @default(now())
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  progress       LectureProgress[]

  @@index([courseId])
  @@index([moduleId])
}

model LectureProgress {
  id              String          @id @default(cuid())
  userId          String
  lectureId       String
  watchedDuration Int             @default(0)
  completed       Boolean         @default(false)
  updatedAt       DateTime        @updatedAt
  activeWatchTime Int             @default(0)
  lastPosition    Int             @default(0)
  engagementScore Int             @default(0)
  playbackEvents  LecturePlaybackEvent[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture         RecordedLecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([lectureId])
}

model LecturePlaybackEvent {
  id         String   @id @default(cuid())
  userId     String
  lectureId  String
  eventType  String
  position   Int      @default(0)
  duration   Int      @default(0)
  metadata   Json?
  createdAt  DateTime @default(now())
  progress   LectureProgress @relation(fields: [userId, lectureId], references: [userId, lectureId], onDelete: Cascade)

  @@index([userId])
  @@index([lectureId])
  @@index([eventType])
  @@index([createdAt])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  status    String
  markedBy  String
  createdAt DateTime @default(now())
  user      User     @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  marker    User     @relation("AttendanceMarker", fields: [markedBy], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Timetable {
  id        String   @id @default(cuid())
  title     String
  batch     String
  subject   String
  instructor String
  startTime DateTime
  endTime   DateTime
  classroom String
  createdAt DateTime @default(now())
}

model Faculty {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String
  designation String
  joiningDate DateTime
  salary      Float
  status      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payrolls    Payroll[]
}

model Classroom {
  id                 String @id @default(cuid())
  name               String
  capacity           Int
  building           String
  availabilityStatus String
}

model Payroll {
  id          String  @id @default(cuid())
  facultyId   String
  month       String
  basicSalary Float
  incentives  Float
  deductions  Float
  totalSalary Float
  paidStatus  String
  faculty     Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  description    String
  targetAudience String
  audience       String?
  createdBy      String?
  creator        User?    @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([createdBy])
  @@index([targetAudience])
}

model Hostel {
  id          String   @id @default(cuid())
  name        String
  type        HostelType
  totalRooms  Int
  wardenName  String
  rooms       Room[]
  allocations HostelAllocation[]
  createdAt   DateTime @default(now())
}

model Room {
  id            String   @id @default(cuid())
  hostelId      String
  roomNumber    String
  floor         Int
  capacity      Int
  occupiedCount Int      @default(0)
  status        String   @default("AVAILABLE")
  hostel        Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allocations   HostelAllocation[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
}

model HostelAllocation {
  id          String   @id @default(cuid())
  studentId   String
  hostelId    String
  roomId      String
  allocatedAt DateTime @default(now())
  status      String   @default("ACTIVE")
  student     User     @relation("HostelAllocationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  hostel      Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([hostelId])
  @@index([roomId])
}

model InOutEntry {
  id        String    @id @default(cuid())
  studentId String
  type      InOutType
  entryTime DateTime  @default(now())
  remarks   String?
  student   User      @relation("InOutEntryStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([entryTime])
}

model HostelLeave {
  id         String   @id @default(cuid())
  studentId  String
  reason     String
  fromDate   DateTime
  toDate     DateTime
  status     String   @default("PENDING")
  approvedBy String?
  student    User     @relation("HostelLeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  approver   User?    @relation("HostelLeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
}

model MessMenu {
  id        String   @id @default(cuid())
  date      DateTime @unique
  breakfast String
  lunch     String
  snacks    String
  dinner    String
}

model DisciplineRecord {
  id          String   @id @default(cuid())
  studentId   String
  category    String
  description String
  severity    String
  actionTaken String
  recordedBy  String
  createdAt   DateTime @default(now())
  student     User     @relation("DisciplineRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recorder    User     @relation("DisciplineRecordRecorder", fields: [recordedBy], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([severity])
}

model ParadePerformance {
  id         String   @id @default(cuid())
  studentId  String
  attendance Int
  discipline Int
  leadership Int
  fitness    Int
  remarks    String?
  createdAt  DateTime @default(now())
  student    User     @relation("ParadePerformanceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

model Lead {
  id          String      @id @default(cuid())
  fullName    String
  mobile      String
  email       String
  targetExam  String
  source      String
  status      LeadStatus  @default(NEW)
  assignedTo  String?
  notes       String?
  assignee    User?       @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  followUps   FollowUp[]
  counsellingBookings CounsellingBooking[]
  admissions  Admission[]
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([source])
  @@index([assignedTo])
  @@index([createdAt])
}

model FollowUp {
  id           String   @id @default(cuid())
  leadId       String
  followUpDate DateTime
  remarks      String
  status       String
  createdBy    String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creator      User     @relation("FollowUpCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([followUpDate])
  @@index([createdBy])
}

model Admission {
  id             String   @id @default(cuid())
  leadId         String?
  studentId      String
  courseId       String
  instituteId    String?
  branchId       String?
  admissionDate  DateTime
  paymentStatus  String
  status         String   @default("PENDING_APPROVAL")
  admissionMode  String   @default("ONLINE")
  approvalStatus String   @default("PENDING")
  approvedBy     String?
  approvedAt     DateTime?
  onboardingStatus String @default("PENDING")
  batch          String
  totalFee       Float    @default(0)
  paidAmount     Float    @default(0)
  dueAmount      Float    @default(0)
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        User     @relation("AdmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  institute      Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  approvals      ApprovalRequest[]
  feePlans       FeePlan[]

  @@index([leadId])
  @@index([studentId])
  @@index([courseId])
  @@index([instituteId])
  @@index([branchId])
  @@index([admissionDate])
  @@index([paymentStatus])
