  answers           AssessmentAnswer[]

  @@index([assessmentId])
  @@index([traitId])
  @@index([dimensionId])
  @@index([status])
  @@index([questionType])
  @@index([difficultyLevel])
}

model AssessmentQuestionOption {
  id              String             @id @default(cuid())
