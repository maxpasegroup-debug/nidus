enum TopRankRole {
  TOPRANK_STUDENT
  TOPRANK_MENTOR
  TOPRANK_ADMIN
  TOPRANK_SUPER_ADMIN
}

model TopRankUser {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String         @unique
  passwordHash  String
  role          TopRankRole    @default(TOPRANK_STUDENT)
  status        String         @default("ACTIVE")
  metadata      Json?
  sessions      TopRankSession[]
  studentProfile TopRankStudentProfile?
  enrollments   TopRankEnrollment[]
  batchAssignments TopRankBatchAssignment[]
  agreements    TopRankProgramAgreement[]
  orientationProgress TopRankOrientationProgress[]
  assessments    TopRankAssessment[]
  aprs           TopRankAPR[]
  missions       TopRankMission[]
  missionCompletions TopRankMissionCompletion[]
  missionCalendars TopRankMissionCalendar[]
  batches       TopRankBatch[] @relation("TopRankBatchStudents")
  mentorBatches TopRankBatch[] @relation("TopRankBatchMentor")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
  @@index([status])
  @@index([phone])
}

model TopRankGateway {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  status      String           @default("COMING_SOON")
  description String?
  metadata    Json?
  programs    TopRankProgram[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
}

model TopRankProgram {
  id        String         @id @default(cuid())
  gatewayId String
  slug      String         @unique
  title     String
  duration  String?
  feeLabel  String?
  status    String         @default("DRAFT")
  metadata  Json?
  gateway   TopRankGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  batches   TopRankBatch[]
  enrollments TopRankEnrollment[]
  agreements TopRankProgramAgreement[]
  orientationProgress TopRankOrientationProgress[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([gatewayId])
  @@index([status])
}

model TopRankBatch {
  id        String         @id @default(cuid())
  programId String
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    String         @default("PLANNED")
  metadata  Json?
  program   TopRankProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  mentorId  String?
  mentor    TopRankUser?   @relation("TopRankBatchMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students  TopRankUser[]  @relation("TopRankBatchStudents")
  enrollments TopRankEnrollment[]
  assignments TopRankBatchAssignment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([programId])
  @@index([mentorId])
  @@index([status])
  @@index([startDate])
}

model TopRankSession {
  id        String      @id @default(cuid())
  userId    String
  tokenHash String      @unique
  rememberMe Boolean    @default(false)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  user      TopRankUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model TopRankStudentProfile {
  id                       String      @id @default(cuid())
  userId                   String      @unique
  age                      Int?
  gender                   String?
  heightCm                 Float?
  weightKg                 Float?
  education                String?
  currentOccupation        String?
  preferredLanguage        String?
  previousAgniveerAttempts Int?
  runningExperience        String?
  pushUpExperience         String?
  sitUpExperience          String?
  currentPreparationLevel  String?
  dailyStudyHours          Float?
  internetAvailability     String?
  deviceType               String?
  learningPreference       String?
  careerGoal               String?
  completionPercentage     Int         @default(0)
  user                     TopRankUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
}

model TopRankEnrollment {
  id               String          @id @default(cuid())
  userId           String
  programId        String
  batchId          String?
  status           String          @default("ONBOARDING")
  currentStep      String          @default("WELCOME")
  enrollmentDate   DateTime        @default(now())
  completedAt      DateTime?
  metadata         Json?
  user             TopRankUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program          TopRankProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  batch            TopRankBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  assignments      TopRankBatchAssignment[]
  agreements       TopRankProgramAgreement[]

  @@index([userId])
  @@index([programId])
  @@index([batchId])
  @@index([status])
}

