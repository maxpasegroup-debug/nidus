  status        String                    @default("ACTIVE")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  assessment    AssessmentArenaAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, name])
  @@index([boardType])
  @@index([status])
}

model AssessmentPilotRun {
  id             String                    @id @default(cuid())
  assessmentId   String
