generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GUEST
  STUDENT
  PARENT
  TEACHER
  ACADEMIC_HEAD
  PHYSICAL_TRAINER
  ADMINISTRATIVE_OFFICER
  BUSINESS_DEVELOPMENT_EXECUTIVE
  DIRECTOR
  TELECALLER
  MARKETING_COORDINATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELLING
  ENROLLED
  LOST
}

enum CounsellingMode {
  ONLINE
  OFFLINE
}

enum HostelType {
  BOYS
  GIRLS
}

enum InOutType {
  IN
  OUT
}

enum OtpType {
  LOGIN
  FORGOT_PASSWORD
  SIGNUP
}

enum AssessmentStatus {
  DRAFT
  REVIEW
  PILOT
  APPROVED
  PUBLISHED
  DEPRECATED
  RETIRED
}

enum AssessmentQuestionType {
  BEHAVIOURAL
  SITUATIONAL
  DECISION
  PRESSURE
  LEADERSHIP
  GROUP_DYNAMICS
  DISCIPLINE
  EXAM
  FITNESS
  SSB
  RANK_PREDICTION
}

enum AssessmentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  mobile         String   @unique
  password       String
  role           Role     @default(STUDENT)
  instituteId    String?
  branchId       String?
  roleMetadata   Json?
  roleOnboardingStatus String @default("PENDING")
  roleActivatedAt DateTime?
  lastRoleActivityAt DateTime?
  emailVerified  Boolean  @default(false)
  mobileVerified Boolean  @default(false)
  isDisabled      Boolean  @default(false)
  disabledAt      DateTime?
  loginFailureCount Int    @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  enrollments    Enrollment[]
  batchEnrollments BatchStudent[]
  teachingAssignments TeacherBatchAssignment[] @relation("TeacherBatchAssignmentTeacher")
  testAttempts   TestAttempt[]
  testsCreated   Test[] @relation("TestTeacher")
  testsApproved  Test[] @relation("TestApprover")
  questionBankItemsCreated QuestionBankItem[] @relation("QuestionBankItemCreator")
  questionVersionsChanged QuestionVersion[] @relation("QuestionVersionChangedBy")
  psychometricAttempts PsychometricAttempt[]
  olqScore       OLQScore?
  studyPlans     StudyPlan[]
  performanceAnalytics PerformanceAnalytics?
  revisionSchedules RevisionSchedule[]
  lectureProgress LectureProgress[]
  attendanceRecords Attendance[] @relation("AttendanceUser")
  markedAttendance Attendance[] @relation("AttendanceMarker")
  facultyProfile Faculty?
  hostelAllocations HostelAllocation[] @relation("HostelAllocationStudent")
  inOutEntries InOutEntry[] @relation("InOutEntryStudent")
  hostelLeaves HostelLeave[] @relation("HostelLeaveStudent")
  approvedHostelLeaves HostelLeave[] @relation("HostelLeaveApprover")
  disciplineRecords DisciplineRecord[] @relation("DisciplineRecordStudent")
  recordedDiscipline DisciplineRecord[] @relation("DisciplineRecordRecorder")
  paradePerformances ParadePerformance[] @relation("ParadePerformanceStudent")
  assignedLeads Lead[] @relation("LeadAssignee")
  followUpsCreated FollowUp[] @relation("FollowUpCreator")
  admissions Admission[] @relation("AdmissionStudent")
  referralsMade Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferred")
  payments Payment[] @relation("PaymentUser")
  collectedPayments Payment[] @relation("PaymentCollector")
  verifiedPayments Payment[] @relation("PaymentVerifier")
  subscriptions Subscription[] @relation("SubscriptionUser")
  feeInstallments FeeInstallment[] @relation("FeeInstallmentStudent")
  invoices Invoice[] @relation("InvoiceStudent")
  approvalRequestsCreated ApprovalRequest[] @relation("ApprovalRequester")
  approvalRequestsReviewed ApprovalRequest[] @relation("ApprovalReviewer")
  scholarships ScholarshipDiscount[] @relation("ScholarshipStudent")
  scholarshipReviewActions ScholarshipDiscount[] @relation("ScholarshipApprover")
  notifications Notification[] @relation("NotificationUser")
  messageThreads MessageThread[] @relation("MessageThreadCreator")
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  communicationAnnouncements Announcement[] @relation("AnnouncementCreator")
  aiInterviewSessions AIInterviewSession[]
  doubtQueries DoubtQuery[]
  aiRecommendations AIRecommendation[]
  officerPotential OfficerPotential?
  fitnessProfile FitnessProfile?
  ptAttendances PTAttendance[] @relation("PTAttendanceStudent")
  physicalEligibilities PhysicalEligibility[]
  dailyFitnessLogs DailyFitnessLog[]
  quizBattleParticipants QuizBattleParticipant[]
  leaderboard Leaderboard?
  mediaFolders MediaFolder[] @relation("MediaFolderCreator")
  mediaFiles MediaFile[] @relation("MediaFileUploader")
  documents Document[] @relation("DocumentUploader")
  adminRoles UserRole[]
  roleActivities RoleActivity[]
  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]
  salesBoosterCampaignsCreated SalesBoosterCampaign[] @relation("SalesBoosterCampaignCreator")
  salesBoosterCampaignsApproved SalesBoosterCampaign[] @relation("SalesBoosterCampaignApprover")
  salesBoosterAudienceContacts SalesBoosterAudienceContact[] @relation("SalesBoosterAudienceContactCreator")
  sessionTokens SessionToken[]
  passwordResets PasswordReset[]
  parentInvitationsSent ParentStudentInvitation[] @relation("ParentInvitationParent")
  parentInvitationsReceived ParentStudentInvitation[] @relation("ParentInvitationStudent")
  parentLinks ParentStudentLink[] @relation("ParentLinkParent")
  studentLinks ParentStudentLink[] @relation("ParentLinkStudent")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([role])
  @@index([instituteId])
  @@index([branchId])
  @@index([roleOnboardingStatus])
}

model SessionToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model ParentStudentInvitation {
  id          String   @id @default(cuid())
  parentId    String
  studentId   String
  tokenHash   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  parent      User     @relation("ParentInvitationParent", fields: [parentId], references: [id], onDelete: Cascade)
  student     User     @relation("ParentInvitationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId, studentId])
  @@index([expiresAt])
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  status    String   @default("ACTIVE")
  monitoringPermissions Json?
  lastViewedAt DateTime?
  linkedAt  DateTime @default(now())
  parent    User     @relation("ParentLinkParent", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("ParentLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([status])
}

model Otp {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  type       OtpType
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  thumbnail   String
  category    String
  examType    String
  duration    String
  price       Float
  isPremium   Boolean      @default(false)
  modules     Module[]
  enrollments Enrollment[]
  batches     Batch[]
  recordedLectures RecordedLecture[]
  admissions  Admission[]
  payments    Payment[]
  feePlans    FeePlan[]
  createdAt   DateTime     @default(now())
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  description String
  videoUrl    String
  pdfUrl      String
  duration    String
  isPreview   Boolean @default(false)
  order       Int
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  progress   Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Batch {
  id          String   @id @default(cuid())
  name        String
  batchType   String
  programSlug String
  courseId    String?
  instituteId String?
  branchId    String?
  startDate   DateTime?
  endDate     DateTime?
  schedule    Json?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  students    BatchStudent[]
  teachers    TeacherBatchAssignment[]
  tests       Test[]

  @@unique([name, programSlug])
  @@index([batchType])
  @@index([programSlug])
  @@index([courseId])
  @@index([status])
  @@index([startDate])
}

model BatchStudent {
  id        String   @id @default(cuid())
  batchId   String
  studentId String
  status    String   @default("ACTIVE")
  joinedAt  DateTime @default(now())
  remarks   String?
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([batchId])
  @@index([studentId])
  @@index([status])
}

model TeacherBatchAssignment {
  id        String   @id @default(cuid())
  batchId   String
  teacherId String
  subject   String
  role      String   @default("FACULTY")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher   User     @relation("TeacherBatchAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([batchId, teacherId, subject])
  @@index([batchId])
  @@index([teacherId])
  @@index([subject])
  @@index([status])
}

model Test {
  id          String        @id @default(cuid())
  title       String
  description String
  examType    String
  category    String
  subject     String?
  topic       String?
  batchId     String?
  teacherId   String?
  publishAt   DateTime?
  publishedAt DateTime?
  releasedById String?
  status      String        @default("DRAFT")
  lifecycle   String        @default("DRAFT")
  examStartsAt DateTime?
  examEndsAt   DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  approvedById String?
  duration    Int
  totalMarks  Float
  expectedQuestionCount Int?
  authoritativeQuestionCount Int?
  expectedTotalMarks Float?
  isMockTest  Boolean       @default(true)
  isLive      Boolean       @default(false)
  batch       Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  teacher     User?         @relation("TestTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  approvedBy  User?         @relation("TestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  questions   Question[]
  questionVersions QuestionVersion[]
  attempts    TestAttempt[]
  createdAt   DateTime      @default(now())

  @@index([batchId])
  @@index([teacherId])
  @@index([status])
  @@index([lifecycle])
  @@index([publishAt])
  @@index([examStartsAt])
  @@index([examEndsAt])
  @@index([subject])
  @@index([batchId, createdAt])
  @@index([lifecycle, publishAt])
  @@index([lifecycle, examStartsAt])
  @@index([lifecycle, examEndsAt])
}

model Question {
  id              String   @id @default(cuid())
  testId          String
  questionText    String
  questionImage   String?
  visualReviewRequired Boolean @default(false)
  visualReviewNotes Json?
  contentJson     Json?
  sourceDocumentId String?
  sourcePageNumber Int?
  boundingBoxes   Json?
  latex           Json?
  assets          Json?
  layout          Json?
  renderMode      String   @default("LEGACY_MCQ")
  aiConfidence    Float?
  reviewStatus    String   @default("DRAFT")
  reviewIssues    Json?
  publishedVersion Int     @default(1)
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  explanation     String
  marks           Float
  negativeMarks   Float
  difficultyLevel String
  topic           String
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers         Answer[]
  answerStates    CBTAnswerState[]
  versions        QuestionVersion[]

  @@index([testId])
  @@index([sourceDocumentId])
  @@index([renderMode])
  @@index([reviewStatus])
}

model QuestionVersion {
  id                 String   @id @default(cuid())
  questionId         String
  testId             String
  version            Int      @default(1)
  changeType         String   @default("PUBLISHED")
  changeReason       String?
  changedById        String?
  changedByRole      String?
  questionText       String
  questionImage      String?
  contentJson        Json?
  optionsSnapshot    Json
  answerSnapshot     Json
  explanation        String?
  renderMode         String   @default("LEGACY_MCQ")
  aiConfidence       Float?
  reviewStatus       String   @default("DRAFT")
  sourceDocumentId   String?
  sourcePageNumber   Int?
  boundingBoxes      Json?
  latex              Json?
  assets             Json?
  layout             Json?
  metadataSnapshot   Json?
  createdAt          DateTime @default(now())
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test               Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  changedBy          User?    @relation("QuestionVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([questionId, version])
  @@index([questionId])
  @@index([testId])
  @@index([changedById])
  @@index([changeType])
  @@index([reviewStatus])
}

model QuestionBankItem {
  id              String   @id @default(cuid())
  questionText    String
  questionType    String   @default("SINGLE_CHOICE")
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  explanation     String
  category        String   @default("Defence")
  subCategory     String
  topic           String
  subTopic        String?
  difficulty      String   @default("MEDIUM")
  marks           Float    @default(1)
  negativeMarks   Float    @default(0)
  status          String   @default("DRAFT")
  createdById     String?
  createdBy       User?    @relation("QuestionBankItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([subCategory])
  @@index([topic])
  @@index([difficulty])
  @@index([status])
  @@index([createdById])
}

model TestAttempt {
  id           String    @id @default(cuid())
  userId       String
  testId       String
  score        Float     @default(0)
  totalCorrect Int       @default(0)
  totalWrong   Int       @default(0)
  timeTaken    Int       @default(0)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  lastSavedAt   DateTime?
  status        String    @default("IN_PROGRESS")
  currentQuestionId String?
  sectionState  Json?
  integrityScore Int      @default(100)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      Answer[]
  answerStates CBTAnswerState[]
  integrityEvents CBTIntegrityEvent[]

  @@index([userId])
  @@index([testId])
  @@unique([userId, testId])
}

model CBTAnswerState {
  id              String   @id @default(cuid())
  attemptId       String
  questionId      String
  selectedAnswer  String?
  status          String   @default("UNANSWERED")
  confidence      String?
  timeSpent       Int      @default(0)
  visitCount      Int      @default(0)
  markedForReview Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  attempt         TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, status])
  @@index([questionId])
}

model CBTIntegrityEvent {
  id         String   @id @default(cuid())
  attemptId  String
  eventType  String
  severity   String   @default("LOW")
  metadata   Json?
  createdAt  DateTime @default(now())
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([eventType])
  @@index([createdAt])
}

model Answer {
  id             String      @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model PsychometricTest {
  id           String                 @id @default(cuid())
  title        String
  type         String
  description  String
  duration     Int
  instructions String
  access       String                 @default("CORE")
  category     String                 @default("GENERAL")
  isActive     Boolean                @default(true)
  questions    PsychometricQuestion[]
  attempts     PsychometricAttempt[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model PsychometricQuestion {
  id           String            @id @default(cuid())
  testId       String
  questionText String
  imageUrl     String?
  questionType String
  options      Json?
  order        Int
  test         PsychometricTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      PsychometricAnswer[]

  @@index([testId])
}

model PsychometricAttempt {
  id            String                @id @default(cuid())
  userId        String
  testId        String
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  score         Float                 @default(0)
  aiAnalysis    String?
  overallRemark String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  test          PsychometricTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       PsychometricAnswer[]
  reportSnapshot PsychometricReport?

  @@index([userId])
  @@index([testId])
}

model PsychometricReport {
  id               String             @id @default(cuid())
  attemptId        String             @unique
  userId           String
  testId           String
  score            Float
  readinessBand    String
  report           Json
  scoring          Json
  recommendations  Json
  integritySignals Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  attempt          PsychometricAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
  @@index([createdAt])
}

model PsychometricAnswer {
  id             String               @id @default(cuid())
  attemptId      String
  questionId     String
  answerText     String?
  selectedOption String?
  score          Float                @default(0)
  attempt        PsychometricAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       PsychometricQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model AssessmentArenaAssessment {
  id                    String                    @id @default(cuid())
  slug                  String                    @unique
  name                  String                    @unique
  level                 String
  purpose               String
  description           String?
  status                AssessmentStatus          @default(DRAFT)
  recommendedMinutes    Int?
  minimumQuestionBank   Int                       @default(0)
  recommendedQuestionBank Int                     @default(0)
  idealQuestionBank     Int                       @default(0)
  questionsPerAttempt   Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  traits                AssessmentTrait[]
  dimensions            AssessmentDimension[]
  questions             AssessmentQuestion[]
  reviews               AssessmentQuestionReview[]
  reviewBoards          AssessmentReviewBoard[]
  pilotRuns             AssessmentPilotRun[]
  exposures             AssessmentQuestionExposure[]
  attempts              AssessmentAttempt[]
  growthSnapshots       AssessmentGrowthSnapshot[]
  rankPredictions       AssessmentRankPrediction[]
  reportSnapshots       AssessmentReportSnapshot[]
  traitMappings         AssessmentTraitMapping[]
  dimensionMappings     AssessmentDimensionMapping[]
  questionBlueprint     AssessmentQuestionBlueprint?
  traitBlueprints       AssessmentTraitBlueprint[]
  dimensionBlueprints   AssessmentDimensionBlueprint[]

  @@index([status])
  @@index([level])
}

model AssessmentTraitMapping {
  id                String                    @id @default(cuid())
  assessmentId      String
  traitId           String
  weight            Float                     @default(0)
  isCritical        Boolean                   @default(false)
  isReadinessTrait  Boolean                   @default(true)
  isRiskTrait       Boolean                   @default(false)
  displayOrder      Int                       @default(1)
  rationale         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assessment        AssessmentArenaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  trait             AssessmentTraitLibraryItem @relation(fields: [traitId], references: [id], onDelete: Restrict)
  dimensions        AssessmentDimensionMapping[]
  blueprints        AssessmentTraitBlueprint[]

  @@unique([assessmentId, traitId])
  @@index([assessmentId])
  @@index([traitId])
  @@index([isCritical])
  @@index([isReadinessTrait])
  @@index([isRiskTrait])
  @@index([displayOrder])
}

model AssessmentDimensionMapping {
  id                  String                    @id @default(cuid())
  assessmentId        String
  traitMappingId      String
  dimensionId         String
  weight              Float                     @default(0)
  priority            String                    @default("NORMAL")
  difficultyRelevance String                    @default("LEVEL_1_TO_5")
  minimumQuestions    Int                       @default(0)
  recommendedQuestions Int                      @default(0)
  idealQuestions      Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  assessment          AssessmentArenaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  traitMapping        AssessmentTraitMapping    @relation(fields: [traitMappingId], references: [id], onDelete: Cascade)
  dimension           AssessmentDimensionLibraryItem @relation(fields: [dimensionId], references: [id], onDelete: Restrict)
  blueprints          AssessmentDimensionBlueprint[]

  @@unique([assessmentId, traitMappingId, dimensionId])
  @@index([assessmentId])
  @@index([traitMappingId])
  @@index([dimensionId])
  @@index([priority])
  @@index([difficultyRelevance])
}

model AssessmentQuestionBlueprint {
  id                      String                    @id @default(cuid())
  assessmentId            String                    @unique
  targetQuestionsPerAttempt Int
  minimumBankSize         Int
  recommendedBankSize     Int
  idealBankSize           Int
  difficultyDistribution  Json
  integrityQuestionPercent Float                    @default(0)
  contradictionQuestionPercent Float                @default(0)
  reverseScoringPercent   Float                     @default(0)
  riskDetectionPercent    Float                     @default(0)
  questionTypeDistribution Json
  status                  String                    @default("ACTIVE")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  assessment              AssessmentArenaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  traitBlueprints         AssessmentTraitBlueprint[]
  dimensionBlueprints     AssessmentDimensionBlueprint[]

  @@index([status])
}

model AssessmentTraitBlueprint {
  id                      String                    @id @default(cuid())
  assessmentId            String
  questionBlueprintId     String
  traitMappingId          String
  targetQuestionCount     Int
  weightPercent           Float
  difficultyDistribution  Json
  integrityQuestionPercent Float                    @default(0)
  riskDetectionPercent    Float                     @default(0)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  assessment              AssessmentArenaAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
