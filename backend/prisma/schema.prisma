  batch        TopRankBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  enrollment   TopRankEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([userId, batchId])
  @@index([batchId])
  @@index([enrollmentId])
  @@index([status])
