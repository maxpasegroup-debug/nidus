model AiWorkflowRequest {
  id             String   @id @default(cuid())
  agentType      String
  requestType    String
  targetType     String?
  targetId       String?
  actorUserId    String?
  actorName      String?
  actorRole      String?
  actingMode     String?
  instituteId    String?
  branchId       String?
  tenantId       String?
  status         String   @default("REQUESTED")
  inputJson      Json
  metadataJson   Json?
  deletedAt      DateTime?
  deletedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contexts       AiWorkflowContext[]
  drafts         AiWorkflowDraft[]
  reviews        AiWorkflowReview[]
  approvals      AiWorkflowApproval[]
  feedback       AiWorkflowFeedback[]
  publications   AiWorkflowPublication[]
  auditEvents    AiWorkflowAuditEvent[]

  @@index([agentType, status, createdAt])
  @@index([requestType, status])
  @@index([actorUserId, createdAt])
  @@index([tenantId, createdAt])
  @@index([targetType, targetId])
  @@map("ai_workflow_requests")
}

model AiWorkflowContext {
