  importJob        NdieImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([providerId])
  @@index([providerKind])
  @@index([stage])
  @@index([status])
}

model NdieQueueJob {
  id              String   @id @default(cuid())
  importJobId     String
  replayRunId     String?
  idempotencyKey  String?  @unique
  jobType         String
  stage           String
  state           String   @default("QUEUED")
  provider        String   @default("database")
  workerId        String?
  progress        Int      @default(0)
  currentStage    String?
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  retryDelayMs    Int      @default(30000)
  backoffStrategy String   @default("EXPONENTIAL")
  retryHistory    Json?
  diagnostics     Json?
  payload         Json?
  result          Json?
  errorCategory   String?
  errorMessage    String?
  queuedAt        DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  cancelledAt     DateTime?
  nextRunAt       DateTime?
  durationMs      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  importJob       NdieImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([replayRunId])
  @@index([jobType])
  @@index([stage])
  @@index([state])
  @@index([provider])
  @@index([workerId])
  @@index([nextRunAt])
  @@index([queuedAt])
}

