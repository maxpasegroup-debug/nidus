generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  ADMIN
  GUEST
}

enum OtpType {
  LOGIN
  FORGOT_PASSWORD
  SIGNUP
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  mobile         String   @unique
  password       String
  role           Role     @default(STUDENT)
  emailVerified  Boolean  @default(false)
  mobileVerified Boolean  @default(false)
  enrollments    Enrollment[]
  testAttempts   TestAttempt[]
  psychometricAttempts PsychometricAttempt[]
  olqScore       OLQScore?
  studyPlans     StudyPlan[]
  performanceAnalytics PerformanceAnalytics?
  revisionSchedules RevisionSchedule[]
  lectureProgress LectureProgress[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Otp {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  type       OtpType
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  thumbnail   String
  category    String
  examType    String
  duration    String
  price       Float
  isPremium   Boolean      @default(false)
  modules     Module[]
  enrollments Enrollment[]
  recordedLectures RecordedLecture[]
  createdAt   DateTime     @default(now())
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  description String
  videoUrl    String
  pdfUrl      String
  duration    String
  isPreview   Boolean @default(false)
  order       Int
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  progress   Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Test {
  id          String        @id @default(cuid())
  title       String
  description String
  examType    String
  category    String
  duration    Int
  totalMarks  Float
  isMockTest  Boolean       @default(true)
  isLive      Boolean       @default(false)
  questions   Question[]
  attempts    TestAttempt[]
  createdAt   DateTime      @default(now())
}

model Question {
  id              String   @id @default(cuid())
  testId          String
  questionText    String
  questionImage   String?
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  explanation     String
  marks           Float
  negativeMarks   Float
  difficultyLevel String
  topic           String
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@index([testId])
}

model TestAttempt {
  id           String    @id @default(cuid())
  userId       String
  testId       String
  score        Float     @default(0)
  totalCorrect Int       @default(0)
  totalWrong   Int       @default(0)
  timeTaken    Int       @default(0)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@index([userId])
  @@index([testId])
}

model Answer {
  id             String      @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model PsychometricTest {
  id           String                 @id @default(cuid())
  title        String
  type         String
  description  String
  duration     Int
  instructions String
  questions    PsychometricQuestion[]
  attempts     PsychometricAttempt[]
  createdAt    DateTime               @default(now())
}

model PsychometricQuestion {
  id           String            @id @default(cuid())
  testId       String
  questionText String
  imageUrl     String?
  questionType String
  options      Json?
  order        Int
  test         PsychometricTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      PsychometricAnswer[]

  @@index([testId])
}

model PsychometricAttempt {
  id            String                @id @default(cuid())
  userId        String
  testId        String
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  score         Float                 @default(0)
  aiAnalysis    String?
  overallRemark String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  test          PsychometricTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       PsychometricAnswer[]

  @@index([userId])
  @@index([testId])
}

model PsychometricAnswer {
  id             String               @id @default(cuid())
  attemptId      String
  questionId     String
  answerText     String?
  selectedOption String?
  score          Float                @default(0)
  attempt        PsychometricAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       PsychometricQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model OLQScore {
  id                   String   @id @default(cuid())
  userId               String   @unique
  effectiveIntelligence Int     @default(0)
  reasoningAbility      Int     @default(0)
  organizingAbility     Int     @default(0)
  socialAdaptability    Int     @default(0)
  cooperation           Int     @default(0)
  senseOfResponsibility Int     @default(0)
  initiative            Int     @default(0)
  selfConfidence        Int     @default(0)
  speedOfDecision       Int     @default(0)
  abilityToInfluence    Int     @default(0)
  liveliness            Int     @default(0)
  determination         Int     @default(0)
  courage               Int     @default(0)
  stamina               Int     @default(0)
  emotionalStability    Int     @default(0)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id               String   @id @default(cuid())
  userId           String
  targetExam       String
  studyHoursPerDay Int
  targetDate       DateTime
  strengths        Json
  weaknesses       Json
  generatedPlan    Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PerformanceAnalytics {
  id               String   @id @default(cuid())
  userId           String   @unique
  testAccuracy     Float    @default(0)
  weakTopics       Json
  strongTopics     Json
  averageScore     Float    @default(0)
  studyConsistency Int      @default(0)
  revisionRate     Int      @default(0)
  aiSuggestions    Json
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevisionSchedule {
  id           String   @id @default(cuid())
  userId       String
  topic        String
  revisionDate DateTime
  status       String   @default("PENDING")
  priority     String   @default("MEDIUM")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LiveClass {
  id             String   @id @default(cuid())
  title          String
  description    String
  examType       String
  instructorName String
  scheduledAt    DateTime
  duration       Int
  meetingLink    String
  thumbnail      String
  isLive         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model RecordedLecture {
  id             String   @id @default(cuid())
  title          String
  description    String
  courseId       String?
  moduleId       String?
  videoUrl       String
  thumbnail      String
  duration       Int
  instructorName String
  createdAt      DateTime @default(now())
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  progress       LectureProgress[]

  @@index([courseId])
  @@index([moduleId])
}

model LectureProgress {
  id              String          @id @default(cuid())
  userId          String
  lectureId       String
  watchedDuration Int             @default(0)
  completed       Boolean         @default(false)
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture         RecordedLecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([lectureId])
}
