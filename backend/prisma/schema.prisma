  branchId    String?
  metadata    Json?
  onboardingStatus String @default("PENDING")
  assignedAt  DateTime @default(now())
  lastActiveAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([instituteId])
  @@index([branchId])
  @@index([onboardingStatus])
}

model RoleActivity {
  id          String   @id @default(cuid())
  userId      String
  role        Role
  activity    String
  metadata    Json?
  instituteId String?
  branchId    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([role])
  @@index([instituteId])
  @@index([branchId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  module      String
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model QueueJobLog {
  id        String   @id @default(cuid())
  queueName String
  jobName   String
  jobId     String?
  status    String
  attempts  Int      @default(0)
  error     String?
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queueName])
  @@index([status])
  @@index([createdAt])
}

model AIRequestLog {
  id          String   @id @default(cuid())
  feature     String
  model       String
  status      String
  promptChars Int      @default(0)
  outputChars Int      @default(0)
  tokenUsage  Json?
  error       String?
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([feature])
  @@index([status])
  @@index([createdAt])
}

model SalesBoosterCampaign {
  id             String   @id @default(cuid())
  title          String
  track          String
  goal           String
  creativeName   String?
  creativeType   String?
  channels       Json
  aiDraft        Json
  approvalStatus String   @default("DRAFT")
  runStatus      String   @default("API_NOT_CONNECTED")
  reviewNote     String?
  connectorResults Json?
  createdById    String
  approvedById   String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  queuedAt       DateTime?
  lastRunAt       DateTime?
  scheduledAt     DateTime?
  scheduleStatus  String   @default("NOT_SCHEDULED")
  scheduleNote    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation("SalesBoosterCampaignCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy     User?    @relation("SalesBoosterCampaignApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  metricSnapshots SalesBoosterMetricSnapshot[]

  @@index([track])
  @@index([approvalStatus])
  @@index([runStatus])
  @@index([scheduleStatus])
  @@index([scheduledAt])
  @@index([createdById])
  @@index([createdAt])
}

model SalesBoosterMetricSnapshot {
  id          String   @id @default(cuid())
  campaignId  String
  platform    String
  reach       Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  admissions  Int      @default(0)
  spend       Float    @default(0)
  revenue     Float    @default(0)
  notes       String?
  capturedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  campaign    SalesBoosterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([platform])
  @@index([capturedAt])
}

model Branch {
  id            String   @id @default(cuid())
  instituteId   String?
  name          String
  location      String
  contactNumber String
  createdAt     DateTime @default(now())
  institute     Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  users         User[]
  userRoles     UserRole[]
  roleActivities RoleActivity[]
  admissions    Admission[]
  feePlans      FeePlan[]
  payments      Payment[]

  @@index([instituteId])
  @@index([location])
  @@index([createdAt])
}

model Institute {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  city          String?
  state         String?
  contactEmail  String?
  contactNumber String?
  status        String   @default("ACTIVE")
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branches      Branch[]
  users         User[]
  userRoles     UserRole[]
  roleActivities RoleActivity[]
  admissions    Admission[]
  feePlans      FeePlan[]

  @@index([status])
  @@index([createdAt])
}
