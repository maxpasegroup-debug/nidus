generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  ADMIN
  DIRECTOR
  TEACHER
  FACULTY
  WARDEN
  COUNSELLOR
  STAFF
  TRAINER
  GUEST
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELLING
  ENROLLED
  LOST
}

enum CounsellingMode {
  ONLINE
  OFFLINE
}

enum HostelType {
  BOYS
  GIRLS
}

enum InOutType {
  IN
  OUT
}

enum OtpType {
  LOGIN
  FORGOT_PASSWORD
  SIGNUP
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  mobile         String   @unique
  password       String
  role           Role     @default(STUDENT)
  emailVerified  Boolean  @default(false)
  mobileVerified Boolean  @default(false)
  isDisabled      Boolean  @default(false)
  disabledAt      DateTime?
  loginFailureCount Int    @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  enrollments    Enrollment[]
  testAttempts   TestAttempt[]
  psychometricAttempts PsychometricAttempt[]
  olqScore       OLQScore?
  studyPlans     StudyPlan[]
  performanceAnalytics PerformanceAnalytics?
  revisionSchedules RevisionSchedule[]
  lectureProgress LectureProgress[]
  attendanceRecords Attendance[] @relation("AttendanceUser")
  markedAttendance Attendance[] @relation("AttendanceMarker")
  facultyProfile Faculty?
  hostelAllocations HostelAllocation[] @relation("HostelAllocationStudent")
  inOutEntries InOutEntry[] @relation("InOutEntryStudent")
  hostelLeaves HostelLeave[] @relation("HostelLeaveStudent")
  approvedHostelLeaves HostelLeave[] @relation("HostelLeaveApprover")
  disciplineRecords DisciplineRecord[] @relation("DisciplineRecordStudent")
  recordedDiscipline DisciplineRecord[] @relation("DisciplineRecordRecorder")
  paradePerformances ParadePerformance[] @relation("ParadePerformanceStudent")
  assignedLeads Lead[] @relation("LeadAssignee")
  followUpsCreated FollowUp[] @relation("FollowUpCreator")
  admissions Admission[] @relation("AdmissionStudent")
  referralsMade Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferred")
  payments Payment[] @relation("PaymentUser")
  subscriptions Subscription[] @relation("SubscriptionUser")
  feeInstallments FeeInstallment[] @relation("FeeInstallmentStudent")
  invoices Invoice[] @relation("InvoiceStudent")
  notifications Notification[] @relation("NotificationUser")
  messageThreads MessageThread[] @relation("MessageThreadCreator")
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  communicationAnnouncements Announcement[] @relation("AnnouncementCreator")
  aiInterviewSessions AIInterviewSession[]
  doubtQueries DoubtQuery[]
  aiRecommendations AIRecommendation[]
  officerPotential OfficerPotential?
  fitnessProfile FitnessProfile?
  ptAttendances PTAttendance[] @relation("PTAttendanceStudent")
  physicalEligibilities PhysicalEligibility[]
  dailyFitnessLogs DailyFitnessLog[]
  quizBattleParticipants QuizBattleParticipant[]
  leaderboard Leaderboard?
  mediaFolders MediaFolder[] @relation("MediaFolderCreator")
  mediaFiles MediaFile[] @relation("MediaFileUploader")
  documents Document[] @relation("DocumentUploader")
  adminRoles UserRole[]
  auditLogs AuditLog[]
  authVerificationTokens AuthVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  authSessions AuthSession[]
  parentInvitationsSent ParentStudentInvitation[] @relation("ParentInvitationParent")
  parentInvitationsReceived ParentStudentInvitation[] @relation("ParentInvitationStudent")
  parentLinks ParentStudentLink[] @relation("ParentLinkParent")
  studentLinks ParentStudentLink[] @relation("ParentLinkStudent")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuthVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  device           String?
  browser          String?
  ipAddress        String?
  userAgent        String?
  loginAt          DateTime @default(now())
  lastActivityAt   DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model ParentStudentInvitation {
  id          String   @id @default(cuid())
  parentId    String
  studentId   String
  tokenHash   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  parent      User     @relation("ParentInvitationParent", fields: [parentId], references: [id], onDelete: Cascade)
  student     User     @relation("ParentInvitationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId, studentId])
  @@index([expiresAt])
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  linkedAt  DateTime @default(now())
  parent    User     @relation("ParentLinkParent", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("ParentLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Otp {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  type       OtpType
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  thumbnail   String
  category    String
  examType    String
  duration    String
  price       Float
  isPremium   Boolean      @default(false)
  modules     Module[]
  enrollments Enrollment[]
  recordedLectures RecordedLecture[]
  admissions  Admission[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  description String
  videoUrl    String
  pdfUrl      String
  duration    String
  isPreview   Boolean @default(false)
  order       Int
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  progress   Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Test {
  id          String        @id @default(cuid())
  title       String
  description String
  examType    String
  category    String
  duration    Int
  totalMarks  Float
  isMockTest  Boolean       @default(true)
  isLive      Boolean       @default(false)
  questions   Question[]
  attempts    TestAttempt[]
  createdAt   DateTime      @default(now())
}

model Question {
  id              String   @id @default(cuid())
  testId          String
  questionText    String
  questionImage   String?
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  explanation     String
  marks           Float
  negativeMarks   Float
  difficultyLevel String
  topic           String
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@index([testId])
}

model TestAttempt {
  id           String    @id @default(cuid())
  userId       String
  testId       String
  score        Float     @default(0)
  totalCorrect Int       @default(0)
  totalWrong   Int       @default(0)
  timeTaken    Int       @default(0)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@index([userId])
  @@index([testId])
}

model Answer {
  id             String      @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model PsychometricTest {
  id           String                 @id @default(cuid())
  title        String
  type         String
  description  String
  duration     Int
  instructions String
  questions    PsychometricQuestion[]
  attempts     PsychometricAttempt[]
  createdAt    DateTime               @default(now())
}

model PsychometricQuestion {
  id           String            @id @default(cuid())
  testId       String
  questionText String
  imageUrl     String?
  questionType String
  options      Json?
  order        Int
  test         PsychometricTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      PsychometricAnswer[]

  @@index([testId])
}

model PsychometricAttempt {
  id            String                @id @default(cuid())
  userId        String
  testId        String
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  score         Float                 @default(0)
  aiAnalysis    String?
  overallRemark String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  test          PsychometricTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       PsychometricAnswer[]

  @@index([userId])
  @@index([testId])
}

model PsychometricAnswer {
  id             String               @id @default(cuid())
  attemptId      String
  questionId     String
  answerText     String?
  selectedOption String?
  score          Float                @default(0)
  attempt        PsychometricAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       PsychometricQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model OLQScore {
  id                   String   @id @default(cuid())
  userId               String   @unique
  effectiveIntelligence Int     @default(0)
  reasoningAbility      Int     @default(0)
  organizingAbility     Int     @default(0)
  socialAdaptability    Int     @default(0)
  cooperation           Int     @default(0)
  senseOfResponsibility Int     @default(0)
  initiative            Int     @default(0)
  selfConfidence        Int     @default(0)
  speedOfDecision       Int     @default(0)
  abilityToInfluence    Int     @default(0)
  liveliness            Int     @default(0)
  determination         Int     @default(0)
  courage               Int     @default(0)
  stamina               Int     @default(0)
  emotionalStability    Int     @default(0)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id               String   @id @default(cuid())
  userId           String
  targetExam       String
  studyHoursPerDay Int
  targetDate       DateTime
  strengths        Json
  weaknesses       Json
  generatedPlan    Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PerformanceAnalytics {
  id               String   @id @default(cuid())
  userId           String   @unique
  testAccuracy     Float    @default(0)
  weakTopics       Json
  strongTopics     Json
  averageScore     Float    @default(0)
  studyConsistency Int      @default(0)
  revisionRate     Int      @default(0)
  aiSuggestions    Json
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevisionSchedule {
  id           String   @id @default(cuid())
  userId       String
  topic        String
  revisionDate DateTime
  status       String   @default("PENDING")
  priority     String   @default("MEDIUM")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LiveClass {
  id             String   @id @default(cuid())
  title          String
  description    String
  examType       String
  instructorName String
  scheduledAt    DateTime
  duration       Int
  meetingLink    String
  thumbnail      String
  isLive         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model RecordedLecture {
  id             String   @id @default(cuid())
  title          String
  description    String
  courseId       String?
  moduleId       String?
  videoUrl       String
  thumbnail      String
  duration       Int
  instructorName String
  createdAt      DateTime @default(now())
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  progress       LectureProgress[]

  @@index([courseId])
  @@index([moduleId])
}

model LectureProgress {
  id              String          @id @default(cuid())
  userId          String
  lectureId       String
  watchedDuration Int             @default(0)
  completed       Boolean         @default(false)
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture         RecordedLecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([lectureId])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  status    String
  markedBy  String
  createdAt DateTime @default(now())
  user      User     @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  marker    User     @relation("AttendanceMarker", fields: [markedBy], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Timetable {
  id        String   @id @default(cuid())
  title     String
  batch     String
  subject   String
  instructor String
  startTime DateTime
  endTime   DateTime
  classroom String
  createdAt DateTime @default(now())
}

model Faculty {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String
  designation String
  joiningDate DateTime
  salary      Float
  status      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payrolls    Payroll[]
}

model Classroom {
  id                 String @id @default(cuid())
  name               String
  capacity           Int
  building           String
  availabilityStatus String
}

model Payroll {
  id          String  @id @default(cuid())
  facultyId   String
  month       String
  basicSalary Float
  incentives  Float
  deductions  Float
  totalSalary Float
  paidStatus  String
  faculty     Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  description    String
  targetAudience String
  audience       String?
  createdBy      String?
  creator        User?    @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([createdBy])
  @@index([targetAudience])
}

model Hostel {
  id          String   @id @default(cuid())
  name        String
  type        HostelType
  totalRooms  Int
  wardenName  String
  rooms       Room[]
  allocations HostelAllocation[]
  createdAt   DateTime @default(now())
}

model Room {
  id            String   @id @default(cuid())
  hostelId      String
  roomNumber    String
  floor         Int
  capacity      Int
  occupiedCount Int      @default(0)
  status        String   @default("AVAILABLE")
  hostel        Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allocations   HostelAllocation[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId])
}

model HostelAllocation {
  id          String   @id @default(cuid())
  studentId   String
  hostelId    String
  roomId      String
  allocatedAt DateTime @default(now())
  status      String   @default("ACTIVE")
  student     User     @relation("HostelAllocationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  hostel      Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([hostelId])
  @@index([roomId])
}

model InOutEntry {
  id        String    @id @default(cuid())
  studentId String
  type      InOutType
  entryTime DateTime  @default(now())
  remarks   String?
  student   User      @relation("InOutEntryStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([entryTime])
}

model HostelLeave {
  id         String   @id @default(cuid())
  studentId  String
  reason     String
  fromDate   DateTime
  toDate     DateTime
  status     String   @default("PENDING")
  approvedBy String?
  student    User     @relation("HostelLeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  approver   User?    @relation("HostelLeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status])
}

model MessMenu {
  id        String   @id @default(cuid())
  date      DateTime @unique
  breakfast String
  lunch     String
  snacks    String
  dinner    String
}

model DisciplineRecord {
  id          String   @id @default(cuid())
  studentId   String
  category    String
  description String
  severity    String
  actionTaken String
  recordedBy  String
  createdAt   DateTime @default(now())
  student     User     @relation("DisciplineRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recorder    User     @relation("DisciplineRecordRecorder", fields: [recordedBy], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([severity])
}

model ParadePerformance {
  id         String   @id @default(cuid())
  studentId  String
  attendance Int
  discipline Int
  leadership Int
  fitness    Int
  remarks    String?
  createdAt  DateTime @default(now())
  student    User     @relation("ParadePerformanceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

model Lead {
  id          String      @id @default(cuid())
  fullName    String
  mobile      String
  email       String
  targetExam  String
  source      String
  status      LeadStatus  @default(NEW)
  assignedTo  String?
  notes       String?
  assignee    User?       @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  followUps   FollowUp[]
  counsellingBookings CounsellingBooking[]
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([source])
  @@index([assignedTo])
  @@index([createdAt])
}

model FollowUp {
  id           String   @id @default(cuid())
  leadId       String
  followUpDate DateTime
  remarks      String
  status       String
  createdBy    String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creator      User     @relation("FollowUpCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([followUpDate])
  @@index([createdBy])
}

model Admission {
  id             String   @id @default(cuid())
  studentId      String
  courseId       String
  admissionDate  DateTime
  paymentStatus  String
  batch          String
  createdAt      DateTime @default(now())
  student        User     @relation("AdmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([admissionDate])
  @@index([paymentStatus])
}

model CounsellingBooking {
  id             String          @id @default(cuid())
  leadId         String
  counsellorName String
  bookingDate    DateTime
  mode           CounsellingMode
  status         String
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([bookingDate])
  @@index([status])
}

model Referral {
  id             String   @id @default(cuid())
  referrerUserId String
  referredUserId String
  rewardStatus   String
  createdAt      DateTime @default(now())
  referrer       User     @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred       User     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([referredUserId])
  @@index([rewardStatus])
}

model Payment {
  id                 String   @id @default(cuid())
  userId             String
  courseId           String?
  amount             Float
  currency           String   @default("INR")
  razorpayOrderId    String   @unique
  razorpayPaymentId  String?
  razorpaySignature  String?
  paymentStatus      String   @default("CREATED")
  paymentMethod      String?
  createdAt          DateTime @default(now())
  user               User     @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  course             Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  planName  String
  startDate DateTime
  endDate   DateTime
  status    String
  amount    Float
  createdAt DateTime @default(now())
  user      User     @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

model FeeInstallment {
  id         String    @id @default(cuid())
  studentId  String
  title      String
  amount     Float
  dueDate    DateTime
  paidStatus String    @default("PENDING")
  paidAt     DateTime?
  student    User      @relation("FeeInstallmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([dueDate])
  @@index([paidStatus])
}

model Invoice {
  id            String   @id @default(cuid())
  studentId     String
  invoiceNumber String   @unique
  amount        Float
  generatedAt   DateTime @default(now())
  status        String
  student       User     @relation("InvoiceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String
  type       String
  targetRole String?
  isRead     Boolean  @default(false)
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetRole])
  @@index([isRead])
  @@index([createdAt])
}

model MessageThread {
  id        String   @id @default(cuid())
  subject   String
  createdBy String
  createdAt DateTime @default(now())
  creator   User     @relation("MessageThreadCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([createdBy])
  @@index([createdAt])
}

model Message {
  id            String   @id @default(cuid())
  threadId      String
  senderId      String
  receiverId    String
  message       String
  attachmentUrl String?
  createdAt     DateTime @default(now())
  thread        MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender        User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  status    String
  sentAt    DateTime @default(now())

  @@index([recipient])
  @@index([status])
  @@index([sentAt])
}

model PushNotification {
  id             String   @id @default(cuid())
  title          String
  body           String
  targetAudience String
  status         String
  createdAt      DateTime @default(now())

  @@index([targetAudience])
  @@index([status])
}

model AIInterviewSession {
  id            String   @id @default(cuid())
  userId        String
  examType      String
  interviewType String
  status        String   @default("ACTIVE")
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  overallScore  Float?
  aiFeedback    String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions     AIInterviewQuestion[]

  @@index([userId])
  @@index([status])
}

model AIInterviewQuestion {
  id         String   @id @default(cuid())
  sessionId  String
  question   String
  userAnswer String?
  aiAnalysis String?
  score      Float?
  createdAt  DateTime @default(now())
  session    AIInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model DoubtQuery {
  id         String   @id @default(cuid())
  userId     String
  question   String
  subject    String
  aiResponse String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject])
}

model AIRecommendation {
  id             String   @id @default(cuid())
  userId         String
  category       String
  recommendation String
  priority       String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([priority])
}

model OfficerPotential {
  id                 String   @id @default(cuid())
  userId             String   @unique
  leadershipScore    Float
  communicationScore Float
  disciplineScore    Float
  confidenceScore    Float
  officerReadiness   Float
  aiSummary          String
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FitnessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  height        Float
  weight        Float
  bmi           Float
  runningTime   Float
  pushups       Int
  pullups       Int
  situps        Int
  staminaScore  Float
  fitnessLevel  String
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PTSchedule {
  id            String   @id @default(cuid())
  title         String
  description   String
  scheduledDate DateTime
  trainerName   String
  activityType  String
  duration      Int
  createdAt     DateTime @default(now())
  attendances   PTAttendance[]

  @@index([scheduledDate])
  @@index([activityType])
}

model PTAttendance {
  id               String   @id @default(cuid())
  studentId        String
  ptScheduleId     String
  attendanceStatus String
  remarks          String?
  markedAt         DateTime @default(now())
  student          User     @relation("PTAttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  ptSchedule       PTSchedule @relation(fields: [ptScheduleId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([ptScheduleId])
}

model PhysicalEligibility {
  id                String   @id @default(cuid())
  userId            String
  examType          String
  eligibilityStatus String
  heightEligible    Boolean
  weightEligible    Boolean
  bmiEligible       Boolean
  staminaEligible   Boolean
  overallRemark     String
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examType])
  @@index([eligibilityStatus])
}

model DailyFitnessLog {
  id              String   @id @default(cuid())
  userId          String
  runningDistance Float
  caloriesBurned  Float
  waterIntake     Float
  workoutDuration Int
  notes           String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PYQCategory {
  id        String   @id @default(cuid())
  name      String
  examType  String
  createdAt DateTime @default(now())
  questions PYQQuestion[]

  @@unique([name, examType])
  @@index([examType])
}

model PYQQuestion {
  id              String   @id @default(cuid())
  categoryId      String
  year            Int
  subject         String
  topic           String
  questionText    String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  explanation     String
  difficultyLevel String
  createdAt       DateTime @default(now())
  category        PYQCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([year])
  @@index([subject])
  @@index([topic])
}

model CurrentAffair {
  id            String   @id @default(cuid())
  title         String
  description   String
  category      String
  imageUrl      String?
  publishedDate DateTime
  createdAt     DateTime @default(now())
  quizzes       CurrentAffairQuiz[]

  @@index([category])
  @@index([publishedDate])
}

model CurrentAffairQuiz {
  id              String   @id @default(cuid())
  currentAffairId String
  question        String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctAnswer   String
  currentAffair   CurrentAffair @relation(fields: [currentAffairId], references: [id], onDelete: Cascade)

  @@index([currentAffairId])
}

model QuizBattle {
  id           String   @id @default(cuid())
  title        String
  category     String
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime @default(now())
  participants QuizBattleParticipant[]

  @@index([category])
  @@index([startTime])
}

model QuizBattleParticipant {
  id        String @id @default(cuid())
  battleId  String
  userId    String
  score     Int    @default(0)
  rank      Int?
  timeTaken Int    @default(0)
  battle    QuizBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([userId])
}

model Leaderboard {
  id        String   @id @default(cuid())
  userId    String   @unique
  points    Int      @default(0)
  streak    Int      @default(0)
  rank      Int?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([points])
  @@index([rank])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdBy String
  createdAt DateTime @default(now())
  parent    MediaFolder? @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaFolder[] @relation("MediaFolderTree")
  creator   User     @relation("MediaFolderCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  files     MediaFile[]

  @@index([parentId])
  @@index([createdBy])
  @@index([createdAt])
}

model MediaFile {
  id            String   @id @default(cuid())
  fileName      String
  originalName  String
  fileType      String
  fileSize      Int
  cloudinaryUrl String
  publicId      String
  folderId      String?
  uploadedBy    String
  createdAt     DateTime @default(now())
  folder        MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader      User     @relation("MediaFileUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([uploadedBy])
  @@index([fileType])
  @@index([createdAt])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String
  uploadedBy  String
  createdAt   DateTime @default(now())
  uploader    User     @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([uploadedBy])
  @@index([createdAt])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  permissions RolePermission[]
  users       UserRole[]

  @@index([createdAt])
}

model Permission {
  id        String   @id @default(cuid())
  name      String   @unique
  module    String
  action    String
  createdAt DateTime @default(now())
  roles     RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@index([action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id     String    @id @default(cuid())
  userId String
  roleId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  module      String
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model Branch {
  id            String   @id @default(cuid())
  name          String
  location      String
  contactNumber String
  createdAt     DateTime @default(now())

  @@index([location])
  @@index([createdAt])
}
