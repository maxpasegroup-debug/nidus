{
  "name": "nidus-platform",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "start": "npm run start:frontend",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "test:public-beta": "npx prisma validate --config backend/prisma.config.ts && npm run lint --workspace frontend && npm run build --workspace backend && npm run build --workspace frontend && npm run test:auth --workspace backend && npm run test:infra --workspace backend && npm run test:cbt --workspace backend && npm run test:payments --workspace backend && npm run test:ai --workspace backend && npm run test:ops --workspace backend",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "bootstrap:production": "npm run bootstrap:production --workspace backend",
    "db:readiness": "npm run db:readiness --workspace backend",
    "queue:readiness": "npm run queue:readiness --workspace backend",
    "integrations:readiness": "npm run integrations:readiness --workspace backend",
    "security:readiness": "npm run security:readiness --workspace backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace backend"
  }
}
